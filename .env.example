# ── Banco (os_db) ───────────────────────────────
DB_USER=os_service
DB_PASSWORD=os_service
DB_HOST=localhost
DB_PORT=5432
DB_NAME=os_db

# ── Autenticação ────────────────────────────────
# Mesmo segredo nos 3 serviços e na Lambda (tokens são validados localmente)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Token das rotas /internal/* (chamadas pela Lambda)
INTERNAL_API_TOKEN=

# ── Mensageria (SQS) ────────────────────────────
AWS_REGION=sa-east-1
# Apenas local (LocalStack). Em AWS, deixe vazio.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_PREFIX=fiap-officine
# Consumer + outbox relay + varredor de timeouts no mesmo processo da API
RUN_WORKERS=true

# ── Timeouts da saga (segundos) ─────────────────
SAGA_APPROVAL_TIMEOUT_SECONDS=172800
SAGA_PAYMENT_TIMEOUT_SECONDS=1800

# ── App / Observabilidade ───────────────────────
APP_ENV=development
LOG_LEVEL=INFO
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=officine-os-service
